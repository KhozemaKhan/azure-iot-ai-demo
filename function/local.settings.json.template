{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "DefaultEndpointsProtocol=https;AccountName=<STORAGE_ACCOUNT_NAME>;AccountKey=<STORAGE_ACCOUNT_KEY>;EndpointSuffix=core.windows.net",
    "FUNCTIONS_WORKER_RUNTIME": "node",

    "IoTHubConnection": "Endpoint=sb://<IOTHUB_NAMESPACE>.servicebus.windows.net/;SharedAccessKeyName=iothubowner;SharedAccessKey=<IOTHUB_PRIMARY_KEY>;EntityPath=<IOTHUB_EVENTHUB_PATH>",
    "IoTHubEventHubName": "<IOTHUB_EVENTHUB_PATH>",
    "IoTHubConsumerGroup": "telemetry-decoder-fn",

    "OutputContainerName": "telemetry-decoded"
  }
}
